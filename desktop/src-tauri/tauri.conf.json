{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Populate",
  "version": "0.1.0",
  "identifier": "com.rjosefsberg.populate",
  "build": {
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "windows": [
      {
        "title": "Populate",
        "width": 1280,
        "height": 840,
        "url": "http://127.0.0.1:5000"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/populate-backend"],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
